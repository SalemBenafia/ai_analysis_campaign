# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=InsightAI
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_in_production_minimum_32_chars_long_string
API_V1_PREFIX=/api/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_jwt_secret_minimum_32_chars_long_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=insightai
POSTGRES_USER=insight
POSTGRES_PASSWORD=insight_secret
DATABASE_URL=postgresql+asyncpg://insight:insight_secret@localhost:5433/insightai

# ─── DuckDB (analytics engine — in-process, no container) ────────────────────
DUCKDB_PATH=/app/duckdb_data/analytics.db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_123
MINIO_BUCKET_DATASETS=insightai-datasets
MINIO_BUCKET_REPORTS=insightai-reports
MINIO_SECURE=false

# ─── AI / LLM — Groq (free tier, auto-rotating model pool) ────────────────────
# Get a key at https://console.groq.com/keys
# GROQ_MODELS is an ordered pool: when a model hits its rate limit the next
# one takes over automatically. Edit this list as Groq's free lineup changes.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.1-8b-instant
GROQ_REQUEST_TIMEOUT=30
GROQ_MAX_TOKENS=1500
GROQ_COOLDOWN_SECONDS=60

# ─── Semantic Layer — Cube Core ───────────────────────────────────────────────
# Generate both secrets with: openssl rand -hex 32
CUBE_API_URL=http://cube:4000
CUBEJS_API_SECRET=generate_me_with_openssl_rand_hex_32____________
CUBE_INTERNAL_TOKEN=generate_me_with_openssl_rand_hex_32____________
SEMANTIC_ENGINE=cube

# ─── Transform / Scheduler ────────────────────────────────────────────────────
DBT_ENABLED=true
SCHEDULER_ENABLED=true

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
